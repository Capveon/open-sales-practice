# Copy to apps/web/.env.local (and apps/agent/.env.local if you run LiveKit).

# --- App ---
OSP_AUTH=none
OSP_VOICE_MODE=mock
OSP_APP_NAME=Open Sales Practice
NEXT_PUBLIC_OSP_APP_NAME=Open Sales Practice
NEXT_PUBLIC_OSP_PRODUCT=Practice
NEXT_PUBLIC_OSP_TAGLINE=Live buyer calls. YAML personas. Scored tapes.
# NEXT_PUBLIC_OSP_MARK=arch

# Extra profile roots, colon-separated. `profiles/private` is loaded automatically if present.
# OSP_PROFILES_DIR=
# OSP_EXTRA_PROFILES=

# --- Auth (when OSP_AUTH=clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
OSP_ALLOWED_EMAIL_DOMAIN=

# --- OpenAI (required for live buyers) ---
OPENAI_API_KEY=
OPENAI_BUYER_MODEL=gpt-4.1-mini
OPENAI_SCORE_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=whisper-1

# --- ElevenLabs (preferred spoken voice) ---
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# --- LiveKit (only when OSP_VOICE_MODE=voice) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OSP_AGENT_NAME=open-sales-practice

# --- Database ---
# Local default is SQLite. For hosted Postgres (including Supabase), use a postgres URL.
DATABASE_URL=file:./data/osp.sqlite
# DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=require
# OSP_DB_SCHEMA=osp
