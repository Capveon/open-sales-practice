# Copy to apps/web/.env.local (pnpm setup does this).
# The agent also reads this file. Do not commit it.

# Clerk — https://dashboard.clerk.com  (Development instance for local)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# OpenAI — https://platform.openai.com/api-keys
# Needs gpt-realtime (the call) and gpt-4.1-mini (the score).
OPENAI_API_KEY=

# LiveKit Cloud — https://cloud.livekit.io  → your project → Settings → Keys
# URL looks like wss://<project>.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Local default. Postgres in production: postgres://...
DATABASE_URL=file:./data/osp.sqlite
