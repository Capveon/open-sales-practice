{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-sales-practice",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Bind Hyperdrive in a private overlay (not committed) when deploying to Workers.
  // Example: "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<config id>" }]
  "vars": {
    "OSP_AUTH": "clerk",
    "OSP_VOICE_MODE": "mock",
    "OSP_DB_SCHEMA": "osp",
    "OSP_APP_NAME": "Open Sales Practice",
    "NEXT_PUBLIC_OSP_APP_NAME": "Open Sales Practice",
    "NEXT_PUBLIC_OSP_PRODUCT": "Practice",
    "NEXT_PUBLIC_OSP_TAGLINE": "Live buyer calls. YAML personas. Scored tapes."
  }
}
